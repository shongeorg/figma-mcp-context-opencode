# ---------------------------------------------------------------
# GreenShop backend — local environment
#
# Copy this file to `.env` and fill in the real values.
# `python-dotenv` reads it; real process env vars still win.
# ---------------------------------------------------------------

# Neon Postgres DSN. Leave empty to fall back to a local SQLite file
# (backend/db.sqlite3) so that `migrate` / `runserver` work immediately.
# Neon requires TLS, so keep ?sslmode=require at the end.
NEON_DB=

# Django
DJANGO_ENV=dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Shop tuning
PRODUCTS_PER_PAGE=9
REVIEWS_PER_PAGE=5
CART_SESSION_DAYS=30

# Only used when DJANGO_ENV=prod
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=shop@greenshop.local
ORDER_NOTIFY_EMAIL=


UNSPLASH_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
