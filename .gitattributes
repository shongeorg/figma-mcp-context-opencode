# Normalize line endings: LF is stored in the repository, the working copy
# keeps the platform default (core.autocrlf handles the conversion).
* text=auto

# Windows-specific scripts must keep CRLF so cmd/PowerShell read them literally.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never diff or merge binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary

# Useful diffs for the design exports in previews/.
*.svg   diff
